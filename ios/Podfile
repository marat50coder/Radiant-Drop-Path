platform :ios, '15.0'

# --- Restore GoogleService-Info.plist on CI ---------------------------------
# The plist is git-ignored (public repo). On CI, provide the content as a
# Secure env variable in Codemagic. Accepted variable names (first non-empty
# wins): GOOGLE_SERVICES_INFO_PLIST, GOOGLE_SERVICES_INFO_PLIST_B64,
# GOOGLE_SERVICE_INFO_PLIST. Value may be:
#   - the raw plist XML (starts with `<?xml`), OR
#   - a base64-encoded blob (whitespace ignored).
# Missing env → `pod install` FAILS immediately with a clear message so the
# error can't slip through to the Xcode archive step.
require 'base64'
_google_services_plist = File.expand_path('Runner/GoogleService-Info.plist', __dir__)
unless File.exist?(_google_services_plist)
  _raw = (
    ENV['GOOGLE_SERVICES_INFO_PLIST'] ||
    ENV['GOOGLE_SERVICES_INFO_PLIST_B64'] ||
    ENV['GOOGLE_SERVICE_INFO_PLIST'] ||
    ''
  ).to_s.strip
  if _raw.empty?
    raise <<~ERR

      ============================================================================
      [Radiant Drop Path CI] Missing GoogleService-Info.plist
      ----------------------------------------------------------------------------
      The file ios/Runner/GoogleService-Info.plist is not in the repo (git-ignored
      because the repository is public). Set it as a Secure environment variable
      in Codemagic:

          Variable name : GOOGLE_SERVICES_INFO_PLIST
          Value         : base64-encoded plist  (or raw XML starting with <?xml)
          Group         : any (e.g. `firebase`) — attach the group to the workflow.

      Then re-run the build.
      ============================================================================

    ERR
  end
  _content =
    if _raw.start_with?('<?xml') || _raw.include?('<!DOCTYPE plist')
      _raw
    else
      Base64.decode64(_raw.gsub(/\s+/, ''))
    end
  unless _content.include?('BUNDLE_ID') || _content.include?('<?xml')
    raise "[Radiant Drop Path CI] GOOGLE_SERVICES_INFO_PLIST env var value does " \
          "not look like a valid GoogleService-Info.plist (decoded #{_content.bytesize} bytes)."
  end
  File.write(_google_services_plist, _content)
  Pod::UI.puts "[Radiant Drop Path] Restored ios/Runner/GoogleService-Info.plist (#{_content.bytesize} bytes)."
end
# ---------------------------------------------------------------------------

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'
install! 'cocoapods', :disable_input_output_paths => true

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

target 'RadiantMediaService' do
  use_frameworks!
  platform :ios, '15.0'
  pod 'Firebase/Messaging', '12.15.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end
end
